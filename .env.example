# Set these in Vercel and locally in .env.local. Values prefixed with VITE_ are browser-visible configuration; never commit a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Google Cloud Console'da Maps JavaScript API etkinleştirilmiş tarayıcı anahtarı.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY
